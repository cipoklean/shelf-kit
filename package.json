{
  "name": "shelf-kit",
  "version": "1.0.0",
  "description": "Your reading year as a bookshelf, from a Goodreads export: an Outlook-safe email, a print poster PDF and a share card. Built with Hyper Elements.",
  "scripts": {
    "render:pdf": "tsx scripts/render-pdf.tsx",
    "render:email": "tsx scripts/render-email.tsx",
    "preview:email": "tsx scripts/render-email.tsx --preview",
    "render:card": "tsx scripts/render-card.tsx",
    "render": "npm run render:pdf && npm run render:email && npm run render:card",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hyper-elements",
    "goodreads",
    "reading",
    "email",
    "pdf",
    "react"
  ],
  "author": "cipoklean",
  "license": "MIT",
  "dependencies": {
    "@hyper-elements/email-clients": "^0.5.3",
    "@hyper-elements/react": "^0.5.2",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
